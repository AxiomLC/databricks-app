# USPTO ODP API key (X-API-Key header) — get one at https://developer.uspto.gov/
USPTO_API_KEY=

# OpenAlex API key (optional, raises rate limit)
OPENALEX_API_KEY=

# Databricks workspace / token (used by notebooks/AppKit)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=momentum
