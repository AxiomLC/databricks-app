# ─── Databricks ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
# OAuth M2M alternative to PAT:
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=momentum
DATABRICKS_SCHEMA=momentum
DATABRICKS_VOLUME_PATH=/Volumes/momentum/momentum/landing

# ─── Lakebase (pgvector) ──────────────────────────────────────
# Host only — no scheme, no user, no path.
LAKEBASE_HOST=ep-xxxxxxxx-xxxxxxxx.database.us-east-2.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=Admin
LAKEBASE_PASSWORD=
LAKEBASE_SSLMODE=require

# ─── Ingestion / staging ──────────────────────────────────────
# Local dir the n8n Write Binary File nodes target, before Volume sync
STAGING_DIR=C:/Users/q1fre/ZED/databricks-app/data

# ─── Source API keys ──────────────────────────────────────────
USPTO_ODP_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
HUGGINGFACE_TOKEN=

# ─── n8n ──────────────────────────────────────────────────────
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_MCP_ACCESS_TOKEN=

# ─── UI (Databricks AppKit) ───────────────────────────────────
PORT=8050
GENIE_SPACE_ID=
# VITE_ vars are bundled into client JS — never put secrets here.
VITE_DATABRICKS_HOST=
VITE_DATABRICKS_WAREHOUSE_ID=
