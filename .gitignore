# Databricks AppKit build output
ui/dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Env / secrets — never commit real keys
.env
.env.*
!*.env.example

# Node
node_modules/

# Local data / scratch
data/
*.parquet
*.jsonl
!schemas/**/*.json

# Written at runtime by the n8n 'Write pillars.json' node
pillars.json

# Local scratch
archive/

# n8n: the canvas export is published on purpose (the flow is the interesting
# part), so n8n/ is NOT ignored — only stray loose files are.
n8n/*
!n8n/README.md
!n8n/ingestion-master.json

# OS / editor
.DS_Store
Thumbs.db

# UI data snapshot (generated by scripts/export_ui_data.py)
ui/public/data/

# Screenshot harness output (ui/.shot.mjs)
.shots/
